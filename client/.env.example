# ── AgriMesh Client (React + Vite) ───────────────────────────────────────────
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL of the Node/Express API gateway (no trailing /v1 needed, it's added
# automatically by src/services/apiClient.js)
VITE_API_URL=http://localhost:8000/api

# Google Maps JavaScript API key (field boundary map, satellite tiles)
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth client ID (login with Google)
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Google Earth Engine OAuth client ID (satellite imagery layers)
VITE_EE_CLIENT_ID=
