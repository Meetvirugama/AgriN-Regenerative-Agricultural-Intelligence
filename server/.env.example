# ── AgriMesh API Gateway (Node/Express) ──────────────────────────────────────
# Copy this file to .env and fill in real values:
#   cp .env.example .env

# PostgreSQL connection string (PostGIS extension required — see docker-compose.yml)
DATABASE_URL=postgresql://agrimesh:agrimesh@localhost:5432/agrimesh

# Port the Express server listens on
PORT=8000

# Comma-separated list of origins allowed to call this API (CORS)
ALLOWED_ORIGINS=http://localhost:5173

# node_env: development | production | test
NODE_ENV=development

# Base URL of the Python/FastAPI ai-service, INCLUDING the /api/v1 prefix
# (must match how ai-service/main.py mounts its routers)
PYTHON_SERVICE_URL=http://localhost:8001/api/v1

# Used by server-side Gemini calls that don't go through ai-service (if any)
GEMINI_API_KEY=

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Copernicus Data Space Ecosystem credentials (satellite imagery)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
